#include <gtest/gtest.h>

#include <cmath>
#include <cstddef>
#include <numeric>
#include <vector>

#include "ParX/ParallelExecutor.hpp"
#ifdef __CUDACC__
#include "ParX/util/CudaArray.cuh"
#endif

// clang-format off
#include "${PAR_EXEC_HEADER}"

decltype(auto) to_parx_range(auto&& host_range) {
#ifdef __CUDACC__
  return ParX::CudaArray{host_range};
#else
  return std::forward<decltype(host_range)>(host_range);
#endif
}

decltype(auto) to_host_range(auto&& parx_range) {
#ifdef __CUDACC__
  auto host_range = std::vector<
      typename std::remove_cvref_t<decltype(parx_range)>::value_type>(
      parx_range.size());
  ParX::copy_span_device_to_host(host_range, parx_range);
  return host_range;
#else
  return std::forward<decltype(parx_range)>(parx_range);
#endif
}

class ${TEST_NAME} : public testing::Test {
  // clang-format on
 public:
  // Kernel definitions must be public to allow use with CUDA.
  using ElementType = std::ptrdiff_t;
  static constexpr void add_kernel(std::size_t index, ElementType const* a,
                                   ElementType const* b, ElementType* c) {
    c[index] = a[index] + b[index];
  }

  static constexpr auto add_reduction(ElementType a, ElementType b) {
    return a + b;
  }

  static constexpr auto multiply_transform(
      std::size_t index, ElementType const* a, ElementType const* b) {
    return a[index] * b[index];
  }

  static constexpr auto multiply_reduction(ElementType a, ElementType b) {
    return a * b;
  }

  static constexpr auto identity_transform(std::size_t index,
                                           ElementType const* a) {
    return a[index];
  }

 protected:
  static constexpr auto large_prime =
      1'000'003ul;  // This is the first prime number greater than 1,000,000.
                    // The goal of using this number is to test large tasks that
                    // can't be evenly divided among multiple threads.

  static auto generate_input_vector(std::size_t n) {
    auto v = std::vector<ElementType>(n);
    std::iota(std::begin(v), std::end(v), static_cast<ElementType>(1));
    return v;
  }

  auto vector_sum(std::span<ElementType const> a,
                  std::span<ElementType const> b) {
    auto c = std::vector<ElementType>(a.size());
    auto&& dev_c = to_parx_range(c);
    ParX::call_kernel<add_kernel>(par_exec, a.size(), to_parx_range(a).data(),
                                  to_parx_range(b).data(), dev_c.data());
    ParX::synchronize(par_exec);
    return to_host_range(dev_c);
  }

  auto scalar_product(std::span<ElementType const> a,
                      std::span<ElementType const> b) {
    return ParX::transform_reduce<ElementType, add_reduction,
                                  multiply_transform>(
        par_exec, ElementType{}, a.size(), to_parx_range(a).data(),
        to_parx_range(b).data());
  }

  // Closed-form expression for the sum of the squares of integers from 1 to n.
  static constexpr auto sum_of_squares(ElementType n) {
    return n * (n + 1) * (2 * n + 1) / 6;
  }

  static auto generate_multiply_reduction_vector(std::size_t n) {
    // The test vector for the multiply reduction needs to be mostly 1s to
    // prevent overflow.
    auto v = std::vector(n, static_cast<ElementType>(1));
    for (std::size_t i = 1; i < n; i = i * 2 + 1) {
      v[i] = static_cast<ElementType>(2);
    }
    return v;
  }

  auto sequential_product(std::span<ElementType const> a) {
    return ParX::transform_reduce<ElementType, multiply_reduction,
                                  identity_transform>(
        par_exec, static_cast<ElementType>(1), a.size(),
        to_parx_range(a).data());
  }

  static constexpr auto floor_power_of_2(std::size_t n) {
    auto m = ElementType{};
    do {
      m = static_cast<ElementType>(n);
      n = n & (n - 1);
    } while (n != 0);  // Previous value of n was a power of 2 or 0.
    return m;
  }

  // clang-format off
  static_assert(ParX::ParallelExecutor<${PAR_EXEC_TYPE}>);
  ${PAR_EXEC_TYPE} par_exec{${CTOR_ARGS}};
};

TEST_F(${TEST_NAME}, SingleSumTest) {
  // This is not a practical use of a ParallelExecutor, but any ParallelExecutor
  // should still produce the correct result.
  auto const a = generate_input_vector(1);
  auto const result = vector_sum(a, a);
  for (std::size_t i = 0; i < a.size(); ++i) {
    ASSERT_EQ(a[i] + a[i], result[i]);
  }
}

TEST_F(${TEST_NAME}, LargePrimeArraySumTest) {
  auto const a = generate_input_vector(large_prime);
  auto const result = vector_sum(a, a);
  for (std::size_t i = 0; i < a.size(); ++i) {
    ASSERT_EQ(a[i] + a[i], result[i]);
  }
}

TEST_F(${TEST_NAME}, SingleScalarProductTest) {
  // This is not a practical use of a ParallelExecutor, but any ParallelExecutor
  // should still produce the correct result.
  auto const a = generate_input_vector(1);
  auto const result = scalar_product(a, a);
  ASSERT_EQ(sum_of_squares(1), result);
}

TEST_F(${TEST_NAME}, LargePrimeArrayScalarProductTest) {
  auto const a = generate_input_vector(large_prime);
  auto const result = scalar_product(a, a);
  ASSERT_EQ(sum_of_squares(large_prime), result);
}

TEST_F(${TEST_NAME}, SingleSequentialProductTest) {
  // This is not a practical use of a ParallelExecutor, but any ParallelExecutor
  // should still produce the correct result.
  auto const a = generate_multiply_reduction_vector(1);
  auto const result = sequential_product(a);
  ASSERT_EQ(floor_power_of_2(1), result);
}

TEST_F(${TEST_NAME}, LargePrimeSequentialProductTest) {
  auto const a = generate_multiply_reduction_vector(large_prime);
  auto const result = sequential_product(a);
  ASSERT_EQ(floor_power_of_2(large_prime), result);
}
// clang-format on
