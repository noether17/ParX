#include <gtest/gtest.h>

#include <atomic>
#include <chrono>
#include <cstddef>
#include <thread>
#include <vector>

#include "ParX/ParallelExecutor.hpp"
#ifdef __CUDACC__
#include "ParX/util/CudaArray.cuh"
#endif

// clang-format off
#include "${PAR_EXEC_HEADER}"

decltype(auto) to_parx_range(auto&& host_range) {
#ifdef __CUDACC__
  return ParX::CudaArray{host_range};
#else
  return std::forward<decltype(host_range)>(host_range);
#endif
}

decltype(auto) to_host_range(auto&& parx_range) {
#ifdef __CUDACC__
  auto host_range = std::vector<
      typename std::remove_cvref_t<decltype(parx_range)>::value_type>(
      parx_range.size());
  ParX::copy_span_device_to_host(host_range, parx_range);
  return host_range;
#else
  return std::forward<decltype(parx_range)>(parx_range);
#endif
}

#ifndef __CUDACC__
  template <typename T>
  using AtomicRef = std::atomic_ref<T>;
#define PARX_HOST_DEVICE
#else
#include <cuda/atomic>
  template <typename T>
  using AtomicRef = cuda::std::atomic_ref<T>;
#define PARX_HOST_DEVICE __host__ __device__
#endif
namespace ParX {
constexpr auto memory_order_relaxed() {
#ifndef __CUDACC__
  return std::memory_order_relaxed;
#else
  return cuda::memory_order_relaxed;
#endif
}

PARX_HOST_DEVICE void nanosleep(unsigned int ns) {
#ifndef __CUDA_ARCH__
  std::this_thread::sleep_for(std::chrono::nanoseconds{ns});
#else
  __nanosleep(ns);
#endif
}
}

class ${TEST_NAME} : public testing::Test {
  // clang-format on
 public:
  // Kernel definitions must be public to allow use with CUDA.
  using ElementType = int;

  enum EVEN_OR_ODD { EVEN = 0, ODD = 1 };
  /* For each element in v, blocks until the element is even or odd valued
   * (depending on the template parameter), then increments it.
   */
  template <EVEN_OR_ODD even_or_odd>
  static PARX_HOST_DEVICE void increment_kernel(std::size_t index,
                                                ElementType* v) {
    auto aref = AtomicRef{v[index]};
    while (true) {
      auto value = ElementType{};
      while ((value = aref.load(ParX::memory_order_relaxed())) % 2 !=
             even_or_odd) {
        ParX::nanosleep(1);
      }
      if (aref.compare_exchange_weak(value, value + 1,
                                     ParX::memory_order_relaxed())) {
        return;
      }
    }
  }

 protected:
  static constexpr auto size = 1;  // Sufficient to check asynchronous behavior.
  static constexpr auto large_prime =
      1'009ul;  // This is the first prime number greater than 1,000.
                // The goal of using this number is to test large tasks that
                // can't be evenly divided among multiple threads. (The
                // asynchronous test uses a smaller prime number than the
                // synchronous test to allow multiple CUDA kernels to run
                // simultaneously on the same GPU.)

  // clang-format off
  static_assert(ParX::AsyncParallelExecutor<${PAR_EXEC_TYPE}>);
  ${PAR_EXEC_TYPE} even_exec{${CTOR_ARGS}};
  ${PAR_EXEC_TYPE} odd_exec{${CTOR_ARGS}};
};

/* This test ensures that increment_kernel<EVEN> is loaded prior to running
 * increment_kernel<ODD>, so that the latter isn't blocked indefinitely in the
 * following test due to lazy loading of CUDA modules.
 */
TEST_F(${TEST_NAME}, IncrementEvenKernelIncrements) {
  // clang-format on
  auto v = std::vector<ElementType>(size, 0);
  auto&& dev_v = to_parx_range(v);

  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, size, dev_v.data());
  ParX::synchronize(even_exec);

  for (auto const x : to_host_range(dev_v)) {
    EXPECT_EQ(1, x);
  }
}

/* This test confirms that ParX::call_kernel<>() runs asynchronously for classes
 * adhering to the AsyncParallelExecutor concept. It does so by executing two
 * kernels, the first of which cannot complete until after the second one runs.
 * If the calls to ParX::call_kernel<>() are not asynchronous, the first call
 * will block indefinitely. (This is not a practical use case, but it serves
 * to confirm the asynchronous behavior.) In order for the two kernels to run in
 * parallel, they must be launched with separate AsyncParallelExecutors.
 */
TEST_F(${TEST_NAME}, CallKernelRunsAsynchronously) {
  // clang-format on
  auto v = std::vector<ElementType>(size, 0);
  auto&& dev_v = to_parx_range(v);

  ParX::call_kernel<increment_kernel<ODD>>(odd_exec, size, dev_v.data());

  // increment_odd_kernel() is blocked until increment_even_kernel() runs, but
  // ParX::call_kernel() does not wait for it to complete.
  for (auto const x : to_host_range(dev_v)) {
    EXPECT_EQ(0, x);
  }

  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, size, dev_v.data());
  ParX::synchronize(odd_exec);
  ParX::synchronize(even_exec);

  // Both kernels have incremented the array elements.
  for (auto const x : to_host_range(dev_v)) {
    EXPECT_EQ(2, x);
  }
}

/* This test confirms that the AsyncParallelExecutor continues to perform
 * correctly for several chained kernel calls on large arrays.
 */
TEST_F(${TEST_NAME}, CallKernelAsynchronousStressTest) {
  // clang-format on
  auto v = std::vector<ElementType>(large_prime, 0);
  auto&& dev_v = to_parx_range(v);

  ParX::call_kernel<increment_kernel<ODD>>(odd_exec, large_prime, dev_v.data());
  ParX::call_kernel<increment_kernel<ODD>>(odd_exec, large_prime, dev_v.data());
  ParX::call_kernel<increment_kernel<ODD>>(odd_exec, large_prime, dev_v.data());
  ParX::call_kernel<increment_kernel<ODD>>(odd_exec, large_prime, dev_v.data());
  ParX::call_kernel<increment_kernel<ODD>>(odd_exec, large_prime, dev_v.data());
  ParX::call_kernel<increment_kernel<ODD>>(odd_exec, large_prime, dev_v.data());
  ParX::call_kernel<increment_kernel<ODD>>(odd_exec, large_prime, dev_v.data());
  ParX::call_kernel<increment_kernel<ODD>>(odd_exec, large_prime, dev_v.data());
  ParX::call_kernel<increment_kernel<ODD>>(odd_exec, large_prime, dev_v.data());
  ParX::call_kernel<increment_kernel<ODD>>(odd_exec, large_prime, dev_v.data());

  // increment_odd_kernel() is blocked until increment_even_kernel() runs, but
  // ParX::call_kernel() does not wait for it to complete.
  for (auto const x : to_host_range(dev_v)) {
    EXPECT_EQ(0, x);
  }

  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, large_prime,
                                            dev_v.data());
  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, large_prime,
                                            dev_v.data());
  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, large_prime,
                                            dev_v.data());
  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, large_prime,
                                            dev_v.data());
  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, large_prime,
                                            dev_v.data());
  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, large_prime,
                                            dev_v.data());
  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, large_prime,
                                            dev_v.data());
  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, large_prime,
                                            dev_v.data());
  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, large_prime,
                                            dev_v.data());
  ParX::call_kernel<increment_kernel<EVEN>>(even_exec, large_prime,
                                            dev_v.data());
  ParX::synchronize(odd_exec);
  ParX::synchronize(even_exec);

  // Both kernels have incremented the array elements.
  for (auto const x : to_host_range(dev_v)) {
    EXPECT_EQ(20, x);
  }
}
